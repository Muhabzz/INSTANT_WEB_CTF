<%- include('partials/header', { title }) %>

<div class="card" style="max-width:420px;margin:0 auto;">
  <h1 class="mt-0">Login</h1>
  <% if (error) { %><div class="alert error"><%= error %></div><% } %>
  <form class="stacked" method="POST" action="/login">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label for="username">Username</label>
    <input id="username" name="username" required value="<%= formValues.username || '' %>">
    <label for="password">Password</label>
    <input id="password" type="password" name="password" required>
    <button class="btn" type="submit" style="width:100%">Login</button>
  </form>
  <p class="muted" style="margin-top:14px">Need an account? <a href="/register">Register</a></p>
</div>

<%- include('partials/footer') %>
