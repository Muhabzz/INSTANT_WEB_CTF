<%- include('../partials/header', { title, navItems, brandSuffix, sessionUserLabel, logoutAction, csrfToken }) %>

<h1 class="mt-0">Rewards</h1>
<div class="grid-2">
  <div class="card">
    <h2 class="mt-0">Your balance</h2>
    <p style="font-size:1.5rem"><strong><%= balance.toLocaleString() %></strong> points</p>
    <% if (formError) { %><div class="alert error"><%= formError %></div><% } %>
    <form class="stacked" method="POST" action="/company/portal/rewards/redeem">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label for="points">Redeem points for account credit (100 pts = $5)</label>
      <input id="points" name="points" type="number" required>
      <button class="btn" type="submit">Redeem</button>
    </form>
  </div>
  <div class="card">
    <h2 class="mt-0">Tiers</h2>
    <ul>
      <li>Bronze - 0 pts</li>
      <li>Silver - 1,000 pts</li>
      <li>Gold - 10,000 pts</li>
      <li>Platinum Concierge - 100,000 pts</li>
    </ul>
    <% if (unlocked) { %>
      <div class="alert success">
        <strong>Platinum Concierge unlocked.</strong> Access code: <%= flag %>
      </div>
    <% } %>
  </div>
</div>

<%
  const bc = typeof bonusClaims !== 'undefined' ? bonusClaims : (companyUser.welcome_bonus_claims || 0);
  const bErr = typeof bonusError !== 'undefined' ? bonusError : null;
  const rFlag = typeof raceFlag !== 'undefined' ? raceFlag : null;
%>
<div class="card" style="margin-top:24px; max-width:480px">
  <h2 class="mt-0">Welcome Bonus</h2>
  <p class="muted">New accounts can claim a one-time 500 point welcome bonus.</p>
  <% if (bErr) { %><div class="alert error"><%= bErr %></div><% } %>
  <% if (bc > 0) { %>
    <p class="muted">You've already claimed your welcome bonus.</p>
  <% } else { %>
    <form method="POST" action="/company/portal/rewards/claim-bonus">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="btn" type="submit">Claim Welcome Bonus</button>
    </form>
  <% } %>
  <% if (rFlag) { %>
    <div class="alert success" style="margin-top:1rem">
      <strong>Bonus claim anomaly detected.</strong> Reference: <%= rFlag %>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
