<%- include('../partials/header', { title, navItems, brandSuffix, sessionUserLabel, logoutAction, csrfToken }) %>

<h1 class="mt-0">Orders</h1>
<div class="card">
  <table>
    <thead><tr><th>Order</th><th>Customer</th><th>Status</th><th>Total</th><th>Placed</th></tr></thead>
    <tbody>
    <% orders.forEach(o => { %>
      <tr>
        <td>#<%= o.id %></td>
        <td><%= o.customer_name %></td>
        <td><span class="pill <%= o.status %>"><%= o.status %></span></td>
        <td>$<%= (o.total_cents / 100).toFixed(2) %></td>
        <td class="muted"><%= new Date(o.created_at).toLocaleDateString() %></td>
      </tr>
    <% }) %>
    </tbody>
  </table>
</div>

<%- include('../partials/footer') %>
