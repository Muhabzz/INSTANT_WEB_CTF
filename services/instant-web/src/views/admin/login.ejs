<%- include('../partials/header', { title, navItems, brandSuffix, sessionUserLabel, logoutAction, csrfToken }) %>

<div class="card" style="max-width:420px;margin:0 auto">
  <h1 class="mt-0">Company Admin Login</h1>
  <% if (error) { %><div class="alert error"><%= error %></div><% } %>
  <form class="stacked" method="POST" action="/company/admin/login">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label for="email">Email</label>
    <input id="email" type="email" name="email" required value="<%= formValues.email || '' %>">
    <label for="password">Password</label>
    <input id="password" type="password" name="password" required>
    <button class="btn" type="submit" style="width:100%">Login</button>
  </form>
</div>

<%- include('../partials/footer') %>
