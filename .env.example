# Copy this file to .env and fill in real values before deploying.
# Never commit the real .env file.
#
# Every value below is a placeholder. All CTF data is synthetic — none of
# these credentials protect real systems.

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
NODE_ENV=production
# Whether session cookies are marked Secure (HTTPS-only). Phase 1 ships with
# nginx on port 80 only (no TLS) - leave this false until you've added a TLS
# server block per docs/DEPLOYMENT.md, otherwise login will silently break
# (the browser drops Secure cookies sent over plain HTTP).
COOKIE_SECURE=false

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
# POSTGRES_USER/PASSWORD is the bootstrap superuser-equivalent role the
# official postgres image creates the database with. No application service
# connects using it - see db/init/01-create-app-roles.sh, which creates two
# least-privilege roles below at first container startup and grants each one
# only what it needs to own its own tables. This is what stops a SQL
# injection reachable through the Instant company app (challenge 02) from
# being able to read the CTF platform's own tables (players, challenge flag
# hashes, etc), even though everything shares one Postgres instance/database.
POSTGRES_DB=instant_ctf
POSTGRES_USER=instant_ctf
POSTGRES_PASSWORD=change_me_postgres_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Least-privilege role used only by ctf-platform.
PLATFORM_DB_USER=platform_app
PLATFORM_DB_PASSWORD=change_me_platform_db_password

# Least-privilege role used by instant-web and internal-api (same trust
# domain - the Instant company app and its internal service).
COMPANY_DB_USER=company_app
COMPANY_DB_PASSWORD=change_me_company_db_password

# ---------------------------------------------------------------------------
# ctf-platform
# ---------------------------------------------------------------------------
PLATFORM_PORT=3000
# Random 32+ byte secret used to sign the CTF platform session cookie.
PLATFORM_SESSION_SECRET=change_me_platform_session_secret
# Seed credentials for the built-in CTF admin account (change after first login).
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@instant-ctf.local
SEED_ADMIN_PASSWORD=change_me_admin_password
# Seed credentials for a demo, non-admin player account.
SEED_PLAYER_USERNAME=demo_player
SEED_PLAYER_EMAIL=demo_player@instant-ctf.local
SEED_PLAYER_PASSWORD=change_me_player_password

# ---------------------------------------------------------------------------
# instant-web (public site, customer/employee/company-admin portals)
# ---------------------------------------------------------------------------
COMPANY_PORT=3001
# Random 32+ byte secrets used to sign each portal's session cookie.
COMPANY_CUSTOMER_SESSION_SECRET=change_me_customer_session_secret
COMPANY_EMPLOYEE_SESSION_SECRET=change_me_employee_session_secret
COMPANY_ADMIN_SESSION_SECRET=change_me_company_admin_session_secret
# Seed credentials for demo company accounts (synthetic data only).
SEED_CUSTOMER_EMAIL=jordan.customer@example.com
SEED_CUSTOMER_PASSWORD=change_me_customer_password
SEED_EMPLOYEE_EMAIL=sam.employee@instant.example
SEED_EMPLOYEE_PASSWORD=change_me_employee_password
SEED_COMPANY_ADMIN_EMAIL=riley.admin@instant.example
SEED_COMPANY_ADMIN_PASSWORD=change_me_company_admin_password

# Random 32+ byte secret used to sign/verify the customer-facing "Instant
# API" bearer tokens (challenge 07). Distinct from the session secrets
# above - this is never sent to the browser as a cookie.
COMPANY_API_JWT_SECRET=change_me_company_api_jwt_secret

# Internal-only service URLs (Docker service DNS names, not publicly reachable)
INTERNAL_API_URL=http://internal-api:4001
TEMPLATE_SERVICE_URL=http://template-service:4002
INFRA_SERVICE_URL=http://infra-service:4003

# ---------------------------------------------------------------------------
# Challenge flags (Phase 2-3, challenges 01-10)
# ---------------------------------------------------------------------------
# Single source of truth for each flag's plaintext. Read by ctf-platform (to
# hash into challenges.flag_hash at seed time) AND by instant-web (which
# needs the literal value to embed/serve at the vulnerable location itself).
# Change these before any shared/public deployment - see docs/CHALLENGES.md
# for the intended discovery/exploitation path for each one.
FLAG_INFO_DISCLOSURE=INSTANT{d3bug_l3ft_1n_pr0d}
FLAG_SQL_INJECTION=INSTANT{un10n_s3l3ct_f0r_th3_w1n}
FLAG_PATH_TRAVERSAL=INSTANT{tr4v3rs1ng_th3_rep0rts}
FLAG_AUTH_BYPASS=INSTANT{l3g4cy_l0g1n_str1k3s_ag41n}
FLAG_XSS=INSTANT{st0r3d_scr1pt_k1dd13}
FLAG_IDOR=INSTANT{1nv0ic3s_ar3nt_pr1v4t3}
FLAG_JWT=INSTANT{n0n3_sh4ll_p4ss_v3r1fy}
FLAG_BUSINESS_LOGIC=INSTANT{n3g4t1v3_p01nts_p0s1t1v3_cr3d1t}
FLAG_CSRF=INSTANT{0n3_cl1ck_st4t3_ch4ng3}
FLAG_FILE_UPLOAD=INSTANT{n0t_4ll_p1x3ls_ar3_p1x3ls}
FLAG_LFI=INSTANT{r3s0lv3_d1sc4rds_th3_b4s3}
FLAG_ADVANCED_SQLI=INSTANT{bl1nd_b00l34n_3xtr4ct10n}
FLAG_SSRF=INSTANT{f3tch_wh4t3v3r_y0u_w4nt}
FLAG_OPEN_REDIRECT=INSTANT{subs7r1ng_1s_n0t_4_h0stn4m3}
FLAG_CORS=INSTANT{r3fl3ct3d_0r1g1n_cr3d3nt14ls}
FLAG_RFI=INSTANT{1ncludes_th3_wr0ng_sn1pp3t}
FLAG_CHAINED_ATTACK=INSTANT{tw0_bugs_0n3_s3ss10n}
FLAG_RACE_CONDITION=INSTANT{ch3ck_th3n_4ct_th3n_l0s3}

# ---------------------------------------------------------------------------
# internal-api / template-service / infra-service
# ---------------------------------------------------------------------------
INTERNAL_API_PORT=4001
TEMPLATE_SERVICE_PORT=4002
INFRA_SERVICE_PORT=4003
